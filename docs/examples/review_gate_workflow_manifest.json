{
  "schema_version": "1",
  "key": "diff-review-resolve",
  "name": "Diff, Review, Resolve",
  "description": "Compare two documents, choose which conflicts to act on, then write the resolution back as a new revision.",
  "version": "1.0.0",
  "tags": ["documents", "llm", "review"],
  "icon": "git-merge",
  "stages": [
    {
      "key": "diff",
      "name": "Select documents",
      "description": "Pick the two documents to compare and the LLM credential to use.",
      "inputs": [
        {
          "key": "file1",
          "label": "First document",
          "type": "resource",
          "required": true,
          "filter": { "extensions": ["pdf", "docx", "xlsx", "txt"] }
        },
        {
          "key": "file2",
          "label": "Second document",
          "type": "resource",
          "required": true,
          "filter": { "extensions": ["pdf", "docx", "xlsx", "txt"] }
        },
        {
          "key": "llm",
          "label": "LLM credential",
          "type": "auth_secret",
          "required": true,
          "filter": { "secret_type": "@token:llm" }
        },
        {
          "key": "prompt",
          "label": "Focus",
          "type": "text",
          "help": "Optional. Tell the model what matters most.",
          "filter": { "multiline": true, "max_length": 2000 }
        }
      ],
      "function": {
        "name": "@istari_utils:smart_diff",
        "version": "1.0.2",
        "target": "file1",
        "parameters": {
          "file1_revision_id": "$inputs.file1.revision_id",
          "file2_resource_id": "$inputs.file2.resource_id",
          "file2_revision_id": "$inputs.file2.revision_id",
          "auth_token": "$inputs.llm.secret_id",
          "prompt": "$inputs.prompt",
          "emit_conflicts": true
        }
      },
      "outputs": [
        { "key": "report", "label": "Diff report (HTML)", "type": "artifact" },
        { "key": "conflicts", "label": "Conflicts", "type": "json", "path": "/conflicts" }
      ]
    },
    {
      "key": "review",
      "name": "Choose conflicts to resolve",
      "description": "Review the conflicts the diff found and decide how to resolve them.",
      "inputs": [
        {
          "key": "conflicts",
          "label": "Conflicts",
          "type": "stage_output",
          "required": true,
          "filter": { "source": "$stages.diff.outputs.conflicts", "multiple": true }
        },
        {
          "key": "strategy",
          "label": "Resolution strategy",
          "type": "enum",
          "required": true,
          "filter": {
            "options": [
              { "value": "prefer_a", "label": "Prefer first document" },
              { "value": "prefer_b", "label": "Prefer second document" },
              { "value": "llm", "label": "Let the LLM propose" }
            ]
          }
        }
      ],
      "view": { "type": "json_table", "source": "$stages.diff.outputs.conflicts" }
    },
    {
      "key": "resolve",
      "name": "Resolve",
      "inputs": [
        {
          "key": "target_doc",
          "label": "Document to update",
          "type": "resource",
          "required": true,
          "filter": { "extensions": ["docx", "xlsx", "txt"] }
        }
      ],
      "function": {
        "name": "@istari_utils:resolve_conflicts",
        "version": "0.3.0",
        "target": "target_doc",
        "parameters": {
          "report_artifact_id": "$stages.diff.outputs.report",
          "conflicts": "$stages.review.inputs.conflicts",
          "strategy": "$stages.review.inputs.strategy",
          "auth_token": "$stages.diff.inputs.llm.secret_id"
        }
      },
      "outputs": [{ "key": "resolved", "label": "Resolved document", "type": "revision" }]
    },
    {
      "key": "results",
      "name": "Results",
      "view": { "type": "summary", "source": "$stages.resolve.outputs" }
    }
  ]
}
